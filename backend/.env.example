# ============================================================
# SkillMirror backend — environment variables
# Copy to `.env` (or export in your shell) and adjust the values.
# NEVER commit real secrets; NEVER expose them in the Angular app.
# ============================================================

# --- HTTP ---
SERVER_PORT=8080

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=skillmirror
MYSQL_USER=skillmirror
MYSQL_PASSWORD=skillmirror

# --- Security ---
# HS256 signing key, at least 32 bytes. REQUIRED in production.
JWT_SECRET=change-me-in-production-0123456789abcdef
# Token lifetime in seconds (default 24h)
JWT_EXPIRATION_SECONDS=86400

# --- CORS (comma separated origins used by the Angular dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- AI (OpenAI-compatible provider) ---
# Leave AI_API_KEY empty to run in DEMO mode: results are deterministic,
# clearly flagged as simulated, and no external call is made.
AI_MODE=auto
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=2500
# Quotas (also editable at runtime from the admin console)
AI_DAILY_USER_LIMIT=40
AI_MONTHLY_TOKEN_BUDGET=2000000

# --- File uploads (evidence) ---
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_EXTENSIONS=pdf,txt,md,png,jpg,jpeg,zip,json,csv,docx

# --- Spring profile: dev = in-memory H2 (no MySQL needed) ---
# SPRING_PROFILES_ACTIVE=dev
